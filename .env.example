# Attendly — Environment Configuration Example
# Copy this file to .env for local development or production deployment.
# Never commit real secrets, API keys, or production database credentials.

# Server & Runtime
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Database (MongoDB Atlas connection URI)
# When MONGODB_URI is not set in local preview, Attendly uses its built-in persistent JSON/file store at ./data/attendly-db.json
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/attendly?retryWrites=true&w=majority"

# Authentication & Security Secrets
JWT_ACCESS_SECRET="replace-with-strong-32-byte-hex-access-secret"
JWT_REFRESH_SECRET="replace-with-strong-32-byte-hex-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8081"

# Email Provider for Password Reset (Optional - required for live password reset emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@attendly.app"

# Google Maps Platform (Optional - used for live Places autocomplete & static map tiles)
# Keep server keys restricted to IP and mobile/client keys restricted to Android package / HTTP referrer.
GOOGLE_MAPS_SERVER_API_KEY=""
VITE_GOOGLE_MAPS_API_KEY=""
EXPO_PUBLIC_API_BASE_URL="http://localhost:3000/api/v1"
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=""
